{
  "name": "@ver2/sdk",
  "version": "0.1.0",
  "description": "Object versioning for Cloudflare R2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBuxo/ver2.git",
    "directory": "sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./s3": {
      "types": "./dist/storage/s3.d.ts",
      "default": "./dist/storage/s3.js"
    },
    "./memory": {
      "types": "./dist/storage/memory.d.ts",
      "default": "./dist/storage/memory.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1151.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
