# Copy to .env.local (git-ignored). Use a DEDICATED test bucket for development.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: override the derived https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# (EU-jurisdiction buckets use https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com)
R2_ENDPOINT=
# Optional: reserved prefix for veR2's own objects
VER2_NAMESPACE=.ver2
